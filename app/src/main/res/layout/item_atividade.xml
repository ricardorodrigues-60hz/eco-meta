<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTipoTransporte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bicicleta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDataAtividade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26/05/2026"
            android:textSize="12sp"
            android:textColor="#757575"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDistancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distância: 12.5 km"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTipoTransporte" />

        <TextView
            android:id="@+id/tvCo2Poupado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CO₂ Evitado: 1.5 kg"
            android:textSize="14sp"
            android:textColor="#388E3C"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDistancia" />

        <TextView
            android:id="@+id/tvPontosGanhos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+25 EcoPoints"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </ConstraintLayout>
</androidx.cardview.widget.CardView>